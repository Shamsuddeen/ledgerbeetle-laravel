{
    "name": "omacy/ledgerbeetle",
    "description": "Double-entry ledger for Laravel, backed by TigerBeetle.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/Shamsuddeen/ledgerbeetle-laravel",
    "authors": [
        {
            "name": "Shamsuddeen",
            "homepage": "https://github.com/Shamsuddeen"
        }
    ],
    "support": {
        "issues": "https://github.com/Shamsuddeen/ledgerbeetle-laravel/issues",
        "source": "https://github.com/Shamsuddeen/ledgerbeetle-laravel"
    },
    "keywords": [
        "laravel",
        "ledger",
        "tigerbeetle",
        "double-entry",
        "accounting"
    ],
    "require": {
        "ext-bcmath": "*",
        "ext-ffi": "*",
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "suggest": {
        "ext-gmp": "Faster 128-bit id and amount conversions (ext-bcmath is used otherwise)"
    },
    "autoload": {
        "psr-4": {
            "LedgerBeetle\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LedgerBeetle\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LedgerBeetle\\Laravel\\LedgerServiceProvider"
            ],
            "aliases": {
                "Ledger": "LedgerBeetle\\Laravel\\Facades\\Ledger"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --exclude-group=integration",
        "test:integration": "vendor/bin/pest --group=integration"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
